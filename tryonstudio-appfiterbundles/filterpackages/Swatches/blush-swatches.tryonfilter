      "mimeType": "image/png",
      "dataUrl": "data:image/png;base64,",
      "blendMode": "source-over"
    }
  ],
  "appRuntime": {
    "schema": "tryonstudio.runtime-contract.v1",
    "rendererId": "tryonstudio-mobile-renderer",
    "minimumRendererVersion": "1.0.0",
    "deepARCompatible": false,
    "trackerRequired": {
      "type": "468-point face mesh",
      "coordinateSpace": "normalized mirrored selfie landmarks",
      "preferred": "MediaPipe Face Landmarker"
    },
    "renderInputs": [
      "native camera frame",
      "468 tracked face landmarks",
      "filter.look.palette",
      "filter.layers",
      "filter.lipControls",
      "filter.eyeControls",
      "filter.browControls",
      "filter.cheekControls",
      "filter.bronzerControls",
      "filter.contourControls",
      "filter.blurControls",
      "filter.lensControls",
      "filter.guide",
      "filter.mobileRenderer",
      "filter.mesh.uv",
      "filter.mesh.triangles",
      "filter.assets"
    ],
    "loadRules": [
      "Do not pass .tryonfilter or .tryonplugin.zip files to DeepAR switchEffect or switchEffectWithSlot.",
      "Decode the filter JSON first, then draw the texture mesh over the native camera frame.",
      "Render custom lip layerOrder as lipstick, optional shimmer, lip liner, then final gloss; gloss uses the centred gloss UV remap.",
      "Use .deepar only for compiled DeepAR effects; use TryOn Studio runtime for these saved looks.",
      "To play a look one layer at a time (a guide), walk filter.guide.steps in order. Each step is one product in the order it would be applied. Apply step.layers together with step.blur, step.bronzer and step.lens to build the look up to that point; apply step.only with the same three flags to show that one layer by itself. The final step reproduces the whole look.",
      "Do not derive an order from filter.layers - it is an unordered map of booleans. filter.guide.steps is the only ordering in the file, and it already omits layers this look does not use."
    ]
  },
  "iosRuntime": {
    "decode": "Parse JSON, decode each assets[].dataUrl to UIImage/CGImage, then render texture triangles using mesh.uv and mesh.triangles over the tracked face landmarks.",
    "colour": "Use look.palette.lips and look.palette.lipliner as tint colours, lipControls.shimmerColor for pearl shimmer, and lipControls.blend, lipControls.textureDetail, lipControls.shimmer, lipControls.gloss and lipControls.sheer controlling opacity. Use eyeControls for eyeshadow style, shade count, custom colours, liner shape, lash style, and optional iris colour. If lipControls.lipColourMode is 'independent', render liner as a rim/inward blend only and do not tint the lipstick base with the liner texture. If it is 'blended', the liner may softly tint the lip surface.",
    "mobileLipQuality": "Read mobileRenderer.lipPreviewMode. If it is 'macbook', run mobileRenderer.macbookLipCameraPass before drawing lip colour, shimmer, liner and gloss. This is the saved phone preview look.",
    "fileExtension": ".tryonfilter"
  }
}